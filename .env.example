# Safe local-development values only. Copy to .env and change passwords.
POSTGRES_DB=netpulse
POSTGRES_ADMIN_USER=netpulse_admin
POSTGRES_ADMIN_PASSWORD=change-me-local-admin
POSTGRES_APP_PASSWORD=change-me-local-app
GRAFANA_POSTGRES_PASSWORD=change-me-local-grafana
POSTGRES_EXPORTER_PASSWORD=change-me-local-exporter
QUERY_API_POSTGRES_PASSWORD=change-me-local-query-api
AIRFLOW_METADATA_DB_PASSWORD=change-me-local-airflow-metadata
AIRFLOW_NETPULSE_DB_PASSWORD=change-me-local-airflow-app
AIRFLOW_API_JWT_SECRET=change-me-local-airflow-jwt-secret-at-least-64-bytes-long-0123456789abcdef
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_UID=50000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana-admin
POSTGRES_PORT=5432
KAFKA_EXTERNAL_PORT=29092
# Safe defaults keep Kafka loopback-only. For a trusted LAN deployment, set
# KAFKA_LAN_HOST to the backend's reserved private IPv4 address and bind 0.0.0.0.
KAFKA_LAN_HOST=localhost
KAFKA_EXTERNAL_BIND_ADDRESS=127.0.0.1
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Long-running local service ceilings. Increase individual values only when a
# heavier development workload demonstrates that it needs more headroom.
POSTGRES_MEMORY_LIMIT=384m
KAFKA_MEMORY_LIMIT=768m
EVENT_INGESTOR_MEMORY_LIMIT=256m
QUERY_API_MEMORY_LIMIT=256m
POSTGRES_EXPORTER_MEMORY_LIMIT=128m
KAFKA_EXPORTER_MEMORY_LIMIT=128m
ALERTMANAGER_MEMORY_LIMIT=128m
PROMETHEUS_MEMORY_LIMIT=384m
GRAFANA_MEMORY_LIMIT=768m
NETPULSE_LOG_LEVEL=INFO
NETPULSE_QUERY_API_POOL_MIN_SIZE=1
NETPULSE_QUERY_API_POOL_MAX_SIZE=5
NETPULSE_QUERY_API_POOL_ACQUIRE_TIMEOUT_SECONDS=2.0
NETPULSE_QUERY_API_STATEMENT_TIMEOUT_MS=3000
NETPULSE_QUERY_API_LOG_LEVEL=INFO
NETPULSE_CONSUMER_GROUP=netpulse-ingestion-v1
NETPULSE_DATABASE_URL=postgresql://netpulse_app:change-me-local-app@postgres:5432/netpulse
NETPULSE_ADMIN_DATABASE_URL=postgresql://netpulse_admin:change-me-local-admin@postgres:5432/netpulse
NETPULSE_SIMULATOR_SEED=42
NETPULSE_STREAM_STARTING_OFFSETS=earliest
NETPULSE_STREAM_WATERMARK_DELAY=15 minutes
NETPULSE_STREAM_TRIGGER_MODE=processing-time
NETPULSE_STREAM_TRIGGER_INTERVAL=10 seconds
NETPULSE_STREAM_SHUFFLE_PARTITIONS=6
NETPULSE_CLASSIFIER_LOOKBACK_SECONDS=60
NETPULSE_CLASSIFIER_INTERVAL_SECONDS=10
NETPULSE_CLASSIFIER_MINIMUM_SAMPLES=2
NETPULSE_CLASSIFIER_OPEN_OBSERVATIONS=2
NETPULSE_CLASSIFIER_RESOLVE_OBSERVATIONS=2
NETPULSE_AIRFLOW_STALE_AFTER_SECONDS=900
NETPULSE_AIRFLOW_DELAY_AFTER_SECONDS=600
NETPULSE_AIRFLOW_FAILURE_WEBHOOK_URL=
