{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netpulse.local/schemas/service_check.schema.json",
  "title": "NetPulse service check v1",
  "allOf": [
    {"$ref": "common_envelope.schema.json"},
    {
      "type": "object",
      "required": ["check_type", "endpoint_id", "success", "timeout"],
      "properties": {
        "event_type": {"const": "network.service_check"},
        "check_type": {"enum": ["dns", "http"]},
        "endpoint_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "success": {"type": "boolean"},
        "resolver": {"type": ["string", "null"]},
        "domain": {"type": ["string", "null"]},
        "lookup_duration_ms": {"type": ["number", "null"], "minimum": 0},
        "dns_duration_ms": {"type": ["number", "null"], "minimum": 0},
        "tcp_duration_ms": {"type": ["number", "null"], "minimum": 0},
        "tls_duration_ms": {"type": ["number", "null"], "minimum": 0},
        "ttfb_ms": {"type": ["number", "null"], "minimum": 0},
        "total_duration_ms": {"type": ["number", "null"], "minimum": 0},
        "http_status": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "returned_record_count": {"type": ["integer", "null"], "minimum": 0},
        "timeout": {"type": "boolean"},
        "error_class": {"type": ["string", "null"], "maxLength": 128}
      }
    }
  ]
}
